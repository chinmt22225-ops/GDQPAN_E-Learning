{
  "name": "elearning-gdqpan-monorepo",
  "version": "2.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace=@elearning/backend",
    "demo": "node apps/backend/dist/server.js",
    "dev:backend": "npm run dev --workspace=@elearning/backend",
    "dev:frontend": "npm run dev --workspace=@elearning/frontend",
    "dev": "npm run dev:backend",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
