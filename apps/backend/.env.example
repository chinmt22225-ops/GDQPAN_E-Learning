# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/elearning_gdqpan?directConnection=true

# Redis (Valkey / Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_me_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_me_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Gmail SMTP (Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here
SMTP_FROM="GDQP&AN E-Learning <noreply@gdqpan.edu.vn>"

# Cloudflare R2 (Lưu trữ video & ảnh)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=gdqpan-videos
R2_PUBLIC_DOMAIN=https://video.yourdomain.com
