<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Quản trị E-Learning</title><link rel="stylesheet" href="/style.css"></head><body><header><h1>QUẢN TRỊ E-LEARNING</h1></header><main><section id="login" class="card"><h2>Đăng nhập quản trị</h2><input id="au" placeholder="Tài khoản"><input id="ap" type="password" placeholder="Mật khẩu"><button onclick="login()">Đăng nhập</button></section><section id="panel" class="card hide"><div class="toolbar"><input id="search" placeholder="Tìm MSSV, họ tên, email"><select id="status"><option value="">Tất cả</option><option value="passed">Đạt</option><option value="pending">Chưa đạt</option></select><button onclick="load()">Tìm</button><button onclick="location.href='/api/admin/export.xlsx'">Xuất Excel</button><button onclick="logout()">Đăng xuất</button></div><p id="count"></p><div class="tablewrap"><table><thead><tr><th>STT</th><th>MSSV</th><th>Họ tên</th><th>Email</th><th>Video</th><th>Điểm</th><th>Lần làm</th><th>Trạng thái</th></tr></thead><tbody id="rows"></tbody></table></div></section></main><script src="/admin.js"></script></body></html>
